# Copy this file to .env and fill it in. Never share or commit the real .env.

# The main address of the site, WITHOUT https://  (this is the address Google will index).
SITE_DOMAIN=www.example.com
# The other spelling of the same domain. It redirects to SITE_DOMAIN. Needs its own DNS record too.
ALT_DOMAIN=example.com

# First admin account. Created on the first start only. Remove ADMIN_PASSWORD from this file afterwards.
ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD= (optional; prefer the interactive create-admin command)

# Language of the bare address (iconic-realestate.com/): ar or en
DEFAULT_LANG=ar

# Optional: public name used in titles and structured data
# BRAND_NAME=ICONIC Real Estate

# Optional: every new enquiry is also sent to this address (Zapier, Make, n8n, a Slack incoming webhook...)
# LEAD_WEBHOOK_URL=https://hooks.example.com/...

# Optional: verification codes from Google Search Console and Bing Webmaster Tools (the "meta tag" method)
# GOOGLE_SITE_VERIFICATION=
# BING_SITE_VERIFICATION=
